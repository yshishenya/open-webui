# Production deploy target config (copy to .env.deploy.prod)
# File with real values should be local-only and remain uncommitted.

PROD_HOST=185.130.212.71
PROD_SSH_USER=yan
PROD_PATH=/opt/projects/open-webui
# Must be a Docker Hub repository where the build host's PAT has write access.
# Authenticate once on the build host with: docker login --username <user> docker.io
IMAGE_REPO=yshishenya/yshishenya
DOCKER_PLATFORM=linux/amd64
PROD_SSH_KEY=~/.ssh/airis_prod
# PROD_SSH_PORT=22
PROD_GIT_PULL=1
POST_DEPLOY_STATUS=1

# Public IDs are build inputs (not runtime secrets) and must be present locally.
PUBLIC_YANDEX_METRICA_ID=111392024
# PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Remote runtime env file location for env_target_manager.py (relative to PROD_PATH or absolute)
TARGET_ENV_PATH=.env
